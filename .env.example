# Copy to .env for local development. NEVER commit your real .env.
# On Render these are configured via render.yaml / the dashboard.

# PostgreSQL connection string.
# Render provides this automatically. If omitted, the server falls back to
# in-memory storage (data is lost on restart — dev only).
DATABASE_URL=postgresql://user:password@localhost:5432/chatdb

# Cryptographic secrets. Generate with:  npm run generate-keys
# MASTER_KEY must remain constant — it decrypts stored messages.
MASTER_KEY=
JWT_SECRET=
ADMIN_SECRET=
HMAC_SECRET=

# Shared client key. If set, every request must carry a matching X-Client-Key
# header. Put the SAME value in client/RussChat.lua (CONFIG.CLIENT_KEY).
# Leave empty to disable the check.
CLIENT_KEY=

# Optional
PORT=10000
NODE_ENV=development
MESSAGE_RETENTION_DAYS=30
WHISPER_RETENTION_HOURS=24
