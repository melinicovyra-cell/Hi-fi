{
  "name": "ultra-secure-chat-server",
  "version": "3.0.0",
  "description": "Ultra-Secure Global Chat Server for Roblox with E2E Encryption",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "generate-keys": "node -e \"const crypto=require('crypto');console.log('MASTER_KEY='+crypto.randomBytes(32).toString('hex'));console.log('JWT_SECRET='+crypto.randomBytes(64).toString('hex'));console.log('ADMIN_SECRET='+crypto.randomBytes(32).toString('hex'));console.log('HMAC_SECRET='+crypto.randomBytes(32).toString('hex'));\"",
    "test": "echo 'Server ready for testing'"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "roblox",
    "chat",
    "secure",
    "encryption",
    "e2e",
    "jwt",
    "api"
  ],
  "author": "KRSP Team",
  "license": "MIT"
}
